{
  "name": "api-testing-playwright",
  "version": "1.0.0",
  "description": "API Testing with Playwright",
  "keywords": [
    "api",
    "testing",
    "playwright"
  ],
  "type": "module",
  "engines": {
    "node": ">= 24"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint '**/*.{js,ts}'",
    "lint:fix": "eslint --fix '**/*.{js,ts}'",
    "prepare": "husky",
    "test": "playwright test",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.6.6",
    "dayjs": "1.11.23",
    "eslint": "10.14.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-playwright": "2.12.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12",
    "zod": "4.6.7"
  },
  "lint-staged": {
    "**/*.{js,ts}": [
      "prettier --write .",
      "eslint '**/*.{js,ts}'"
    ]
  }
}
